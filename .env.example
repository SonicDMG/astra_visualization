# Astra Data Explorer — environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and will never be committed.

# Your Astra DB API endpoint (Data API)
# Format: https://<database-id>-<region>.apps.astra.datastax.com
ASTRA_DB_API_ENDPOINT=https://<database-id>-<region>.apps.astra.datastax.com

# Your Astra DB application token (generate in the Astra portal → Settings → Tokens)
# Keep this secret — never commit it.
ASTRA_DB_APPLICATION_TOKEN=AstraCS:<your-token-here>
